# Add these to your .env file. Never commit real keys to version control.

LENCO_SECRET_KEY=your_sandbox_or_live_secret_key
LENCO_PUBLIC_KEY=your_sandbox_or_live_public_key
LENCO_BASE_URL=https://sandbox.lenco.co/access/v1
LENCO_DEBIT_ACCOUNT_ID=your_lenco_account_id_to_pay_from
LENCO_WEBHOOK_SECRET=your_webhook_verification_secret
